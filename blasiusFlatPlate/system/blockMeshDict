/*--------------------------------*- C++ -*----------------------------------*\
  Caso: blasiusFlatPlate - strato limite laminare su lastra piana (Blasius)
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Dominio 2D: tratto a monte con simmetria (x in [-0.2,0]) + lastra (x in [0,1])
// Altezza H = 0.1 m (delta99 a x=1 ~ 0.016 m)
scale   1;

xu  -0.2;   // inizio dominio (a monte del bordo d'attacco)
L    1.0;   // lunghezza lastra
H    0.1;   // altezza dominio
t    0.01;  // spessore (direzione empty)

vertices
(
    ($xu 0  0)  (0 0  0)  ($L 0  0)
    ($xu $H 0)  (0 $H 0)  ($L $H 0)
    ($xu 0  $t) (0 0  $t) ($L 0  $t)
    ($xu $H $t) (0 $H $t) ($L $H $t)
);

blocks
(
    // tratto a monte: celle addensate verso il bordo d'attacco
    hex (0 1 4 3 6 7 10 9)  (50 100 1)  simpleGrading (0.05 30 1)
    // lastra: celle addensate verso bordo d'attacco (x) e parete (y)
    hex (1 2 5 4 7 8 11 10) (250 100 1) simpleGrading (20 30 1)
);

boundary
(
    inlet
    {
        type patch;
        faces ((0 6 9 3));
    }
    outlet
    {
        type patch;
        faces ((2 5 11 8));
    }
    top
    {
        type patch;
        faces ((3 9 10 4) (4 10 11 5));
    }
    symmetryFront
    {
        type symmetryPlane;
        faces ((0 1 7 6));
    }
    plate
    {
        type wall;
        faces ((1 2 8 7));
    }
    frontAndBack
    {
        type empty;
        faces
        (
            (0 3 4 1) (1 4 5 2)
            (6 7 10 9) (7 8 11 10)
        );
    }
);
